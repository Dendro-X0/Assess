{
  "name": "@assess/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:seed-dev-key": "tsx src/scripts/seed-dev-key.ts",
    "db:seed-pro-key": "tsx src/scripts/seed-pro-key.ts"
  },
  "dependencies": {
    "@assess/github": "workspace:*",
    "@assess/scoring": "workspace:*",
    "@assess/signals": "workspace:*",
    "@hono/node-server": "^1.14.1",
    "better-sqlite3": "^11.9.0",
    "dotenv": "^16.4.7",
    "hono": "^4.7.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
